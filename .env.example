# 复制为 .env 或写入 systemd EnvironmentFile；不要把真实值提交。
# LLM
DEEPSEEK_API_KEY=
# Voice
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=
MINIMAX_GROUP_ID=
# QQ / OneBot
QQ_ACCOUNT=
QQ_OWNER=
ONEBOT_WS=ws://127.0.0.1:3002
